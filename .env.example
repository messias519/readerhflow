# PanelFlow / reader.hflow
# Copy this file to .env for local development or configure the same keys in Portainer.

COMPOSE_PROJECT_NAME=panelflow

# Web
NEXT_PUBLIC_APP_NAME=PanelFlow
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://api:8000

# API
API_PORT=8000
STORAGE_PATH=/data/library
DATABASE_URL=postgresql://panelflow:change-me@postgres:5432/panelflow
REDIS_URL=redis://redis:6379/0
SUWAYOMI_URL=http://suwayomi:4567
CORS_ORIGINS=http://localhost:3000,https://reader.hflow.top
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
JWT_SECRET=change-this-long-random-jwt-secret
JWT_ACCESS_TOKEN_MINUTES=720

# PostgreSQL
POSTGRES_DB=panelflow
POSTGRES_USER=panelflow
POSTGRES_PASSWORD=change-me

# Production storage bind mount on the VPS.
# Example: /mnt/gdrive/panelflow/library
PANELFLOW_LIBRARY_HOST_PATH=./data/library

